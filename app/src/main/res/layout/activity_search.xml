<?xml version="1.0" encoding="utf-8"?>
<!--
    @file res/layout/activity_search.xml
    @brief Główny kontener widoku dla `SearchActivity`.
    @details Osadza ekran wyszukiwania kontaktów `screen_search` pod identyfikatorem `searchScreen` na tle `offgrid_background`.
-->

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/offgrid_background"
    tools:context=".SearchActivity">

    <include
        android:id="@+id/searchScreen"
        layout="@layout/screen_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
