<?xml version="1.0" encoding="utf-8"?>
<!--
    @file res/layout/activity_settings.xml
    @brief Główny kontener widoku dla `SettingsActivity`.
    @details Osadza ekran ustawień aplikacji `screen_settings` pod identyfikatorem `settingsScreen` na tle `offgrid_background`.
-->

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/offgrid_background"
    tools:context=".SettingsActivity">

    <include
        android:id="@+id/settingsScreen"
        layout="@layout/screen_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
