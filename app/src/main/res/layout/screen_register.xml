<?xml version="1.0" encoding="utf-8"?>
<!--
    @file screen_register.xml
    @brief Edytowalny formularz rejestracji z nazwą, adresem e-mail i hasłem.
    @details RegisterActivity obsługuje powrót, przejście do logowania i komunikat zamiast utworzenia konta.
-->
<!-- Formularz rejestracji OffGrid. Nawigację obsługuje aktywność. Uwierzytelnianie wymaga konfiguracji. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/register_screen"
    android:orientation="vertical"
    android:background="@color/offgrid_background"
    android:layoutDirection="ltr"
    tools:layout_width="360dp"
    tools:layout_height="720dp"
    tools:ignore="HardcodedText">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">
        <android.widget.Button
            android:id="@+id/register_back"
            style="@style/Widget.OffGrid.ActionButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:text="‹"
            android:contentDescription="@string/back_settings" />
        <TextView
            style="@style/Widget.OffGrid.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/register_title" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/offgrid_divider" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/register_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingTop="24dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create an account"
                android:textSize="16sp"
                android:textColor="@color/offgrid_text_secondary"
                android:fontFamily="sans-serif"
                android:textStyle="normal"
                android:includeFontPadding="false"
                android:layout_marginTop="8dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Full name"
                    android:textSize="12sp"
                    android:textColor="@color/offgrid_text_secondary"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:includeFontPadding="false"
                    android:labelFor="@id/register_name" />
                <android.widget.EditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:id="@+id/register_name"
                    android:hint="Your name"
                    android:inputType="textPersonName"
                    android:textSize="14sp"
                    android:textColor="@color/offgrid_text"
                    android:textColorHint="@color/offgrid_text_secondary"
                    android:background="@color/offgrid_field"
                    android:backgroundTint="@color/offgrid_field"
                    android:fontFamily="sans-serif"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:imeOptions="actionNext"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:longClickable="true"
                    android:cursorVisible="true"
                    android:importantForAutofill="auto"
                    android:autofillHints="name"
                    android:saveEnabled="true"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textSize="12sp"
                    android:textColor="@color/offgrid_text_secondary"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:includeFontPadding="false"
                    android:labelFor="@id/register_email" />
                <android.widget.EditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:id="@+id/register_email"
                    android:hint="you@example.com"
                    android:inputType="textEmailAddress"
                    android:textSize="14sp"
                    android:textColor="@color/offgrid_text"
                    android:textColorHint="@color/offgrid_text_secondary"
                    android:background="@color/offgrid_field"
                    android:backgroundTint="@color/offgrid_field"
                    android:fontFamily="sans-serif"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:imeOptions="actionNext"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:longClickable="true"
                    android:cursorVisible="true"
                    android:importantForAutofill="auto"
                    android:autofillHints="newUsername"
                    android:saveEnabled="true"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textSize="12sp"
                    android:textColor="@color/offgrid_text_secondary"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:includeFontPadding="false"
                    android:labelFor="@id/register_password" />
                <android.widget.EditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:id="@+id/register_password"
                    android:hint="Create password"
                    android:inputType="textPassword"
                    android:textSize="14sp"
                    android:textColor="@color/offgrid_text"
                    android:textColorHint="@color/offgrid_text_secondary"
                    android:background="@color/offgrid_field"
                    android:backgroundTint="@color/offgrid_field"
                    android:fontFamily="sans-serif"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:imeOptions="actionNext"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:longClickable="true"
                    android:cursorVisible="true"
                    android:importantForAutofill="auto"
                    android:autofillHints="newPassword"
                    android:saveEnabled="false"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Confirm password"
                    android:textSize="12sp"
                    android:textColor="@color/offgrid_text_secondary"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:includeFontPadding="false"
                    android:labelFor="@id/register_confirm_password" />
                <!--
                    @brief Pole ponownego wpisania hasła z maskowaniem wprowadzanych znaków.
                    @note W obecnej implementacji zgodność z register_password nie jest sprawdzana.
                -->
                <android.widget.EditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:id="@+id/register_confirm_password"
                    android:hint="Repeat password"
                    android:inputType="textPassword"
                    android:textSize="14sp"
                    android:textColor="@color/offgrid_text"
                    android:textColorHint="@color/offgrid_text_secondary"
                    android:background="@color/offgrid_field"
                    android:backgroundTint="@color/offgrid_field"
                    android:fontFamily="sans-serif"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:imeOptions="actionDone"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:longClickable="true"
                    android:cursorVisible="true"
                    android:importantForAutofill="auto"
                    android:autofillHints="newPassword"
                    android:saveEnabled="false"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
            <!--
                @brief Przycisk rejestracji podłączony w RegisterActivity.
                @note Obecnie pokazuje komunikat o braku konfiguracji; nie waliduje pól ani nie tworzy konta.
            -->
            <android.widget.Button
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:id="@+id/register_submit"
                android:text="Register"
                android:textSize="14sp"
                android:textColor="@color/offgrid_background"
                android:background="@color/offgrid_text"
                android:backgroundTint="@color/offgrid_text"
                android:fontFamily="sans-serif"
                android:textAllCaps="false"
                android:textStyle="normal"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="8dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:includeFontPadding="false"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="24dp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <!--
                @brief Przejście do LoginActivity zastępujące formularz rejestracji.
                @note Zakończenie RegisterActivity zapobiega odkładaniu kolejnych formularzy na stosie.
            -->
            <android.widget.Button
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:id="@+id/register_open_login"
                android:text="Already registered? Log in"
                android:textSize="14sp"
                android:textColor="@color/offgrid_text"
                android:background="@color/offgrid_button"
                android:backgroundTint="@color/offgrid_button"
                android:fontFamily="sans-serif"
                android:textAllCaps="false"
                android:textStyle="normal"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="8dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:includeFontPadding="false"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
