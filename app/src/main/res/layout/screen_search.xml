<?xml version="1.0" encoding="utf-8"?>
<!--!
    @file app/src/main/res/layout/screen_search.xml
    @brief Układ ekranu katalogu i wyszukiwania użytkowników.
    @details Pole zapytania, informacja o własnym profilu, status pobierania, lista wyników i dolna nawigacja.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/offgrid_background"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="96dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="20dp"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:text="@string/tab_search"
        android:textColor="@color/offgrid_text"
        android:textSize="36sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/offgrid_divider" />

    <!--! @brief Aktywne pole zapytania z limitem długości i akcją Search na klawiaturze. -->
    <EditText
        android:id="@+id/search_query"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_field"
        android:backgroundTint="@null"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:drawableTint="@color/offgrid_text_secondary"
        android:fontFamily="sans-serif"
        android:gravity="center_vertical"
        android:hint="@string/search_query_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="textFilter"
        android:maxLength="100"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:singleLine="true"
        android:textColor="@color/offgrid_text"
        android:textColorHint="@color/offgrid_text_secondary"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/search_query_help"
        android:textColor="@color/offgrid_text_secondary"
        android:textSize="12sp" />

    <!--! @brief Sekcja przygotowania własnego profilu, ponawiania zapisu i uzupełniania nazwy. -->
    <LinearLayout
        android:id="@+id/search_profile_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_field"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/search_profile_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/offgrid_text_secondary"
            android:textSize="13sp" />
        <Button
            android:id="@+id/search_profile_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/search_retry"
            android:textAllCaps="false"
            android:visibility="gone" />
    </LinearLayout>

    <!--! @brief Nagłówek rozróżniający przeglądanie katalogu od wyników wyszukiwania. -->
    <TextView
        android:id="@+id/search_results_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"
        android:includeFontPadding="false"
        android:text="@string/search_users_heading"
        android:textColor="@color/offgrid_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">
        <!--! @brief Wskaźnik pobierania pierwszej lub kolejnej strony użytkowników. -->
        <ProgressBar
            android:id="@+id/search_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />
        <!--! @brief Dostępny dla czytnika ekranu komunikat liczby wyników, błędu lub pustej listy. -->
        <TextView
            android:id="@+id/search_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/offgrid_text_secondary"
            android:textSize="13sp" />
        <Button
            android:id="@+id/search_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/search_retry"
            android:textAllCaps="false"
            android:visibility="gone" />
    </LinearLayout>

    <!--! @brief Przewijana lista użytkowników wypełniana przez UserSearchAdapter. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:scrollbars="vertical" />

    <!--! @brief Przycisk pobierania kolejnej strony widoczny po uzyskaniu pełnej partii dokumentów. -->
    <Button
        android:id="@+id/search_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:minHeight="48dp"
        android:text="@string/search_load_more"
        android:textAllCaps="false"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/offgrid_divider" />
    <!--! @brief Wspólny dolny pasek nawigacji aplikacji. -->
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="78dp" />
</LinearLayout>
