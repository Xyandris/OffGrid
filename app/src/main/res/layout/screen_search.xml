<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/search_screen" android:orientation="vertical" android:background="@color/offgrid_background" android:layoutDirection="ltr" tools:layout_width="360dp" tools:layout_height="720dp" tools:ignore="HardcodedText">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp" android:minHeight="96dp" android:paddingTop="20dp" android:paddingBottom="20dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Search" android:textSize="36sp" android:textColor="@color/offgrid_text" android:fontFamily="sans-serif-light" android:textStyle="normal" android:includeFontPadding="false" android:layout_weight="1" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/offgrid_divider" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/search_content" android:orientation="vertical" android:padding="16dp">
            <android.widget.EditText android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/search_query" android:hint="Search contacts..." android:inputType="textFilter" android:textSize="16sp" android:textColor="@color/offgrid_text" android:textColorHint="@color/offgrid_text_secondary" android:background="@drawable/bg_field" android:backgroundTint="@null" android:fontFamily="sans-serif" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical" android:singleLine="true" android:minWidth="0dp" android:minHeight="0dp" android:focusable="false" android:focusableInTouchMode="false" android:clickable="false" android:longClickable="false" android:cursorVisible="false" android:importantForAutofill="no" android:saveEnabled="false" android:contentDescription="Search contacts" android:drawableStart="@drawable/ic_search" android:drawableTint="@color/offgrid_text_secondary" android:drawablePadding="10dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Recent" android:textSize="12sp" android:textColor="@color/offgrid_text_secondary" android:fontFamily="sans-serif" android:textStyle="bold" android:includeFontPadding="false" android:layout_marginTop="24dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="80dp" android:id="@+id/search_recent_sarah" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="52dp" android:layout_height="52dp" android:text="SM" android:textSize="19sp" android:textColor="@color/offgrid_text" android:fontFamily="sans-serif" android:textStyle="normal" android:includeFontPadding="false" android:gravity="center" android:background="@drawable/bg_avatar" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="10dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sarah Miller" android:textSize="20sp" android:textColor="@color/offgrid_text" android:fontFamily="sans-serif" android:textStyle="normal" android:includeFontPadding="false" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="sarah@example.com" android:textSize="11sp" android:textColor="@color/offgrid_text_secondary" android:fontFamily="sans-serif" android:textStyle="normal" android:includeFontPadding="false" android:layout_marginTop="5dp" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
                <android.widget.Button android:layout_width="36dp" android:layout_height="40dp" android:id="@+id/search_remove_recent" android:text="×" android:textSize="24sp" android:textColor="@color/offgrid_text" android:background="?android:attr/selectableItemBackgroundBorderless" android:backgroundTint="@null" android:fontFamily="sans-serif" android:textAllCaps="false" android:textStyle="normal" android:gravity="center" android:minWidth="0dp" android:minHeight="0dp" android:padding="8dp" android:elevation="0dp" android:stateListAnimator="@null" android:includeFontPadding="false" android:clickable="false" android:focusable="false" android:contentDescription="Remove recent search" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/offgrid_divider" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="All contacts" android:textSize="12sp" android:textColor="@color/offgrid_text_secondary" android:fontFamily="sans-serif" android:textStyle="bold" android:includeFontPadding="false" android:layout_marginTop="24dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="80dp" android:id="@+id/search_contact_alex" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="52dp" android:layout_height="52dp" android:text="AJ" android:textSize="19sp" android:textColor="@color/offgrid_text" android:fontFamily="sans-serif" android:textStyle="normal" android:includeFontPadding="false" android:gravity="center" android:background="@drawable/bg_avatar" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="10dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Alex Johnson" android:textSize="20sp" android:textColor="@color/offgrid_text" android:fontFamily="sans-serif" android:textStyle="normal" android:includeFontPadding="false" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="alex@example.com" android:textSize="11sp" android:textColor="@color/offgrid_text_secondary" android:fontFamily="sans-serif" android:textStyle="normal" android:includeFontPadding="false" android:layout_marginTop="5dp" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/offgrid_divider" />
        </LinearLayout>
    </ScrollView>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/offgrid_divider" />
    <include android:id="@+id/bottomNavigation" layout="@layout/bottom_navigation" android:layout_width="match_parent" android:layout_height="78dp" />
</LinearLayout>