<?xml version="1.0" encoding="utf-8"?>
<!--
    @file activity_register.xml
    @brief Layout główny aktywności RegisterActivity.
    @details Dołącza screen_register.xml przez include o identyfikatorze registerScreen.
    Główny FrameLayout otrzymuje odstępy pasków systemowych i klawiatury przez showOffGridScreen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/offgrid_background"
    tools:context=".RegisterActivity">

    <include
        android:id="@+id/registerScreen"
        layout="@layout/screen_register"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
