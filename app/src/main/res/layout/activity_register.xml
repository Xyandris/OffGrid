<?xml version="1.0" encoding="utf-8"?>
<!--
    @file res/layout/activity_register.xml
    @brief Główny kontener widoku dla `RegisterActivity`.
    @details Osadza układ formularza rejestracji `screen_register` pod identyfikatorem `registerScreen` na tle `offgrid_background`.
-->

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/offgrid_background"
    tools:context=".RegisterActivity">

    <include
        android:id="@+id/registerScreen"
        layout="@layout/screen_register"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
