<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/settings_screen"
    android:background="@color/offgrid_background"
    android:layoutDirection="ltr"
    tools:layout_width="360dp"
    tools:layout_height="720dp"
    tools:ignore="HardcodedText"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:minHeight="96dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">
        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:id="@+id/settings_back"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back_home"
            android:visibility="gone"
            style="@style/Widget.OffGrid.IconButton" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:layout_weight="1"
            style="@style/Widget.OffGrid.ScreenTitle" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/settings_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minHeight="128dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:gravity="center_vertical"
                android:id="@+id/settings_profile">
                <TextView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:text="?"
                    android:id="@+id/settingsProfileAvatar"
                    android:textSize="36sp"
                    style="@style/Widget.OffGrid.Avatar"
                    tools:text="JK" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_account_signed_out"
                        android:id="@+id/settingsProfileName"
                        android:textSize="28sp"
                        android:maxLines="2"
                        style="@style/Widget.OffGrid.ContactName"
                        tools:text="Jan Kowalski" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:id="@+id/settingsProfileEmail"
                        android:layout_marginTop="6dp"
                        android:textSize="15sp"
                        android:maxLines="2"
                        style="@style/Widget.OffGrid.SettingsDescription"
                        tools:text="jan.kowalski89@example.com" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/offgrid_divider"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minHeight="74dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:gravity="center_vertical"
                android:id="@+id/settings_notifications"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_notifications"
                    android:tint="@color/offgrid_text"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Notifications"
                        style="@style/Widget.OffGrid.SettingsLabel" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Messages, sounds"
                        android:layout_marginTop="4dp"
                        style="@style/Widget.OffGrid.SettingsDescription" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/offgrid_divider"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minHeight="74dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:gravity="center_vertical"
                android:id="@+id/settings_privacy"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_lock"
                    android:tint="@color/offgrid_text"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Privacy"
                        style="@style/Widget.OffGrid.SettingsLabel" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Last seen, read receipts"
                        android:layout_marginTop="4dp"
                        style="@style/Widget.OffGrid.SettingsDescription" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/offgrid_divider"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minHeight="82dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:gravity="center_vertical"
                android:id="@+id/settings_appearance"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_appearance"
                    android:tint="@color/offgrid_text"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Appearance"
                        style="@style/Widget.OffGrid.SettingsLabel" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/appearance_light"
                        android:layout_marginTop="4dp"
                        android:id="@+id/settings_theme_value"
                        style="@style/Widget.OffGrid.SettingsDescription" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/offgrid_divider"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minHeight="48dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:gravity="center_vertical"
                android:id="@+id/settings_help"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_help"
                    android:tint="@color/offgrid_text"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Help &amp; Support"
                        style="@style/Widget.OffGrid.SettingsLabel"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/offgrid_divider"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minHeight="48dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:gravity="center_vertical"
                android:id="@+id/settings_about"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_info"
                    android:tint="@color/offgrid_text"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="About"
                        style="@style/Widget.OffGrid.SettingsLabel"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/development_title"
                android:id="@+id/developmentSection"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp">
                <android.widget.Button
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:id="@+id/btnLogin"
                    android:text="@string/login_title"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    style="@style/Widget.OffGrid.OutlinedButton"
                    android:layout_marginEnd="10dp" />
                <android.widget.Button
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:id="@+id/btnRegister"
                    android:text="@string/register_title"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    style="@style/Widget.OffGrid.OutlinedButton" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <android.widget.Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:id="@+id/settings_logout"
        android:text="Log out"
        android:background="@drawable/bg_logout"
        android:backgroundTint="@null"
        android:textColor="@color/offgrid_logout_text"
        android:textSize="18sp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        style="@style/Widget.OffGrid.ActionButton" />
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="78dp" />
</LinearLayout>
