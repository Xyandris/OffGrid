<?xml version="1.0" encoding="utf-8"?>
<!--
    @file screen_settings.xml
    @brief Ekran makiety ustawień z działającą sekcją formularzy deweloperskich.
    @details SettingsActivity podłącza powrót, zakładki oraz przyciski btnLogin i btnRegister.
-->
<!--
    USTAWIENIA

    Ekran korzysta ze wspólnej palety OffGrid i dolnego paska nawigacji.
    Aktywność obsługuje wszystkie cztery zakładki. Dane profilu i część opcji ustawień stanowią makietę.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/settings_screen"
    android:orientation="vertical"
    android:background="@color/offgrid_background"
    android:layoutDirection="ltr"
    tools:layout_width="360dp"
    tools:layout_height="720dp"
    tools:ignore="HardcodedText">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">
        <android.widget.Button
            android:id="@+id/settings_back"
            style="@style/Widget.OffGrid.ActionButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:text="‹"
            android:contentDescription="@string/back_home" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="22sp"
            android:textColor="@color/offgrid_text"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:layout_weight="1" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/offgrid_divider" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/settings_content"
            android:orientation="vertical"
            android:padding="16dp">
            <!--
                @brief Początek statycznych pozycji profilu i ustawień aplikacji.
                @note Dane profilu są przykładowe; pozycje ustawień nie mają jeszcze podłączonych akcji.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:id="@+id/settings_profile"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="AC"
                    android:textSize="14sp"
                    android:textColor="@color/offgrid_text"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:background="@color/offgrid_button" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Alex Carter"
                        android:textSize="15sp"
                        android:textColor="@color/offgrid_text"
                        android:fontFamily="sans-serif"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="alex.carter@example.com"
                        android:textSize="11sp"
                        android:textColor="@color/offgrid_text_secondary"
                        android:fontFamily="sans-serif"
                        android:textStyle="normal"
                        android:includeFontPadding="false"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
                <TextView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="24sp"
                    android:textColor="@color/offgrid_text_secondary"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:includeFontPadding="false"
                    android:gravity="center" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/offgrid_divider"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:id="@+id/settings_notifications"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="N"
                    android:textSize="14sp"
                    android:textColor="@color/offgrid_text"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:background="@color/offgrid_field" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Notifications"
                        android:textSize="13sp"
                        android:textColor="@color/offgrid_text"
                        android:fontFamily="sans-serif"
                        android:textStyle="normal"
                        android:includeFontPadding="false" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Message previews, sounds"
                        android:textSize="11sp"
                        android:textColor="@color/offgrid_text_secondary"
                        android:fontFamily="sans-serif"
                        android:textStyle="normal"
                        android:includeFontPadding="false"
                        android:layout_marginTop="5dp" />
                </LinearLayout>
                <TextView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="@color/offgrid_text_secondary"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:includeFontPadding="false"
                    android:gravity="center" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/offgrid_divider" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:id="@+id/settings_privacy"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="P"
                    android:textSize="14sp"
                    android:textColor="@color/offgrid_text"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:background="@color/offgrid_field" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Privacy"
                        android:textSize="13sp"
                        android:textColor="@color/offgrid_text"
                        android:fontFamily="sans-serif"
                        android:textStyle="normal"
                        android:includeFontPadding="false" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Last seen, read receipts"
                        android:textSize="11sp"
                        android:textColor="@color/offgrid_text_secondary"
                        android:fontFamily="sans-serif"
                        android:textStyle="normal"
                        android:includeFontPadding="false"
                        android:layout_marginTop="5dp" />
                </LinearLayout>
                <TextView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="@color/offgrid_text_secondary"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:includeFontPadding="false"
                    android:gravity="center" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/offgrid_divider" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:id="@+id/settings_appearance"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="A"
                    android:textSize="14sp"
                    android:textColor="@color/offgrid_text"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:background="@color/offgrid_field" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Appearance"
                        android:textSize="13sp"
                        android:textColor="@color/offgrid_text"
                        android:fontFamily="sans-serif"
                        android:textStyle="normal"
                        android:includeFontPadding="false" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Light mode"
                        android:textSize="11sp"
                        android:textColor="@color/offgrid_text_secondary"
                        android:fontFamily="sans-serif"
                        android:textStyle="normal"
                        android:includeFontPadding="false"
                        android:layout_marginTop="5dp" />
                </LinearLayout>
                <TextView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="@color/offgrid_text_secondary"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:includeFontPadding="false"
                    android:gravity="center" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/offgrid_divider" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:id="@+id/settings_help"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="?"
                    android:textSize="14sp"
                    android:textColor="@color/offgrid_text"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:background="@color/offgrid_field" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Help and support"
                        android:textSize="13sp"
                        android:textColor="@color/offgrid_text"
                        android:fontFamily="sans-serif"
                        android:textStyle="normal"
                        android:includeFontPadding="false" />
                </LinearLayout>
                <TextView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="@color/offgrid_text_secondary"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:includeFontPadding="false"
                    android:gravity="center" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/offgrid_divider" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:id="@+id/settings_about"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="i"
                    android:textSize="14sp"
                    android:textColor="@color/offgrid_text"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:background="@color/offgrid_field" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="About"
                        android:textSize="13sp"
                        android:textColor="@color/offgrid_text"
                        android:fontFamily="sans-serif"
                        android:textStyle="normal"
                        android:includeFontPadding="false" />
                </LinearLayout>
                <TextView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="@color/offgrid_text_secondary"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:includeFontPadding="false"
                    android:gravity="center" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/offgrid_divider" />
            <!--
                @brief Sekcja deweloperska umożliwiająca otwieranie formularzy konta.
                @details btnLogin otwiera LoginActivity, a btnRegister otwiera RegisterActivity.
                Sekcja pozwala sprawdzić formularze bez skonfigurowanego uwierzytelniania.
            -->
            <TextView
                android:id="@+id/developmentSection"
                style="@style/Widget.OffGrid.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/development_title" />
            <TextView
                style="@style/Widget.OffGrid.ScreenDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/development_description" />
            <android.widget.Button
                android:id="@+id/btnLogin"
                style="@style/Widget.OffGrid.ActionButton"
                android:layout_marginTop="12dp"
                android:text="@string/development_open_login" />
            <android.widget.Button
                android:id="@+id/btnRegister"
                style="@style/Widget.OffGrid.OutlinedButton"
                android:layout_marginTop="8dp"
                android:text="@string/development_open_register" />
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <!--
                @brief Nieaktywny przycisk prezentujący docelowe miejsce wylogowania.
                @note Nie kończy sesji użytkownika; mechanizm uwierzytelniania nie jest skonfigurowany.
            -->
            <android.widget.Button
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:id="@+id/settings_logout"
                android:text="Log out"
                android:textSize="14sp"
                android:textColor="@color/offgrid_text"
                android:background="@color/offgrid_button"
                android:backgroundTint="@color/offgrid_button"
                android:fontFamily="sans-serif"
                android:textAllCaps="false"
                android:textStyle="normal"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="8dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:includeFontPadding="false"
                android:clickable="false"
                android:focusable="false"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </ScrollView>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/offgrid_divider" />
    <!--
        @brief Wspólny pasek zakładek umieszczony poza przewijaną treścią.
        @details Aktywność podłącza ten include przez bindMainTabs z zakładką MainTab.SETTINGS.
    -->
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="60dp" />
</LinearLayout>
