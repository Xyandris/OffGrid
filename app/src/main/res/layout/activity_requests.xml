<?xml version="1.0" encoding="utf-8"?>
<!--
    @file res/layout/activity_requests.xml
    @brief Główny kontener widoku dla `RequestsActivity`.
    @details Osadza ekran zaproszeń do kontaktów `screen_contact_requests` pod identyfikatorem `requestsScreen` na tle `offgrid_background`.
-->

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/offgrid_background"
    tools:context=".RequestsActivity">

    <include
        android:id="@+id/requestsScreen"
        layout="@layout/screen_contact_requests"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
