<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="78dp"
    android:orientation="vertical"
    android:background="@color/offgrid_background"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/offgrid_divider"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="77dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <android.widget.Button
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:id="@+id/tab_chats"
            android:text="@string/tab_chats"
            android:drawableTop="@drawable/ic_chat"
            style="@style/Widget.OffGrid.TabButton" />
        <View
            android:layout_width="1dp"
            android:layout_height="46dp"
            android:background="@color/offgrid_divider"
            android:layout_gravity="center_vertical"
            android:importantForAccessibility="no" />
        <android.widget.Button
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:id="@+id/tab_search"
            android:text="@string/tab_search"
            android:drawableTop="@drawable/ic_search"
            style="@style/Widget.OffGrid.TabButton" />
        <View
            android:layout_width="1dp"
            android:layout_height="46dp"
            android:background="@color/offgrid_divider"
            android:layout_gravity="center_vertical"
            android:importantForAccessibility="no" />
        <android.widget.Button
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:id="@+id/tab_requests"
            android:text="@string/tab_requests"
            android:drawableTop="@drawable/ic_requests_badge"
            style="@style/Widget.OffGrid.TabButton"
            android:drawableTint="@null" />
        <View
            android:layout_width="1dp"
            android:layout_height="46dp"
            android:background="@color/offgrid_divider"
            android:layout_gravity="center_vertical"
            android:importantForAccessibility="no" />
        <android.widget.Button
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:id="@+id/tab_settings"
            android:text="@string/tab_settings"
            android:drawableTop="@drawable/ic_settings"
            style="@style/Widget.OffGrid.TabButton" />
    </LinearLayout>
</LinearLayout>
