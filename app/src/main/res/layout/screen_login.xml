<?xml version="1.0" encoding="utf-8"?>
<!--
LOGIN / STATIC LAYOUT MOCKUP

Place screen_login.xml in app/src/main/res/layout/ and open Design or Split.
This screen is self-contained: all text, colors and placeholder rows are inline.
No other XML, drawable, string, style, image or Java/Kotlin file is required.
Controls are deliberately inert; the file presents placement and spacing only.
Uses Android framework Views compatible with Android 9 (API 28) and newer.
Set minSdk = 28 in your app module to make Android 9 the minimum version.
The tools dimensions are only a preview size; the layout fills its container.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/login_screen"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layoutDirection="ltr"
    tools:layout_width="360dp"
    tools:layout_height="720dp"
    tools:ignore="HardcodedText">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/login_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingTop="40dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Messages"
                android:textSize="24sp"
                android:textColor="#282828"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Log in to your account"
                android:textSize="16sp"
                android:textColor="#686868"
                android:fontFamily="sans-serif"
                android:textStyle="normal"
                android:includeFontPadding="false"
                android:layout_marginTop="8dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textSize="12sp"
                    android:textColor="#686868"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:includeFontPadding="false"
                    android:labelFor="@id/login_email" />
                <android.widget.EditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:id="@+id/login_email"
                    android:hint="you@example.com"
                    android:inputType="textEmailAddress"
                    android:textSize="14sp"
                    android:textColor="#282828"
                    android:textColorHint="#686868"
                    android:background="#F0F0F0"
                    android:backgroundTint="#F0F0F0"
                    android:fontFamily="sans-serif"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:clickable="false"
                    android:longClickable="false"
                    android:cursorVisible="false"
                    android:importantForAutofill="no"
                    android:saveEnabled="false"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textSize="12sp"
                    android:textColor="#686868"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:includeFontPadding="false"
                    android:labelFor="@id/login_password" />
                <android.widget.EditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:id="@+id/login_password"
                    android:hint="Enter password"
                    android:inputType="textPassword"
                    android:textSize="14sp"
                    android:textColor="#282828"
                    android:textColorHint="#686868"
                    android:background="#F0F0F0"
                    android:backgroundTint="#F0F0F0"
                    android:fontFamily="sans-serif"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:clickable="false"
                    android:longClickable="false"
                    android:cursorVisible="false"
                    android:importantForAutofill="no"
                    android:saveEnabled="false"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
            <android.widget.Button
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:id="@+id/login_forgot_password"
                android:text="Forgot password?"
                android:textSize="14sp"
                android:textColor="#282828"
                android:background="#E1E1E1"
                android:backgroundTint="#E1E1E1"
                android:fontFamily="sans-serif"
                android:textAllCaps="false"
                android:textStyle="normal"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="8dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:includeFontPadding="false"
                android:clickable="false"
                android:focusable="false"
                android:layout_marginTop="8dp" />
            <android.widget.Button
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:id="@+id/login_submit"
                android:text="Log in"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:background="#282828"
                android:backgroundTint="#282828"
                android:fontFamily="sans-serif"
                android:textAllCaps="false"
                android:textStyle="normal"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="8dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:includeFontPadding="false"
                android:clickable="false"
                android:focusable="false"
                android:layout_marginTop="12dp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="New here?"
                android:textSize="13sp"
                android:textColor="#686868"
                android:fontFamily="sans-serif"
                android:textStyle="normal"
                android:includeFontPadding="false"
                android:gravity="center"
                android:layout_marginTop="24dp" />
            <android.widget.Button
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:id="@+id/login_open_register"
                android:text="Create account"
                android:textSize="14sp"
                android:textColor="#282828"
                android:background="#E1E1E1"
                android:backgroundTint="#E1E1E1"
                android:fontFamily="sans-serif"
                android:textAllCaps="false"
                android:textStyle="normal"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="8dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:includeFontPadding="false"
                android:clickable="false"
                android:focusable="false"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
