<?xml version="1.0" encoding="utf-8"?>
<!-- OffGrid login form. Navigation is wired in the activity; authentication is not configured. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/login_screen"
    android:orientation="vertical"
    android:background="@color/offgrid_background"
    android:layoutDirection="ltr"
    tools:layout_width="360dp"
    tools:layout_height="720dp"
    tools:ignore="HardcodedText">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">
        <android.widget.Button
            android:id="@+id/login_back"
            style="@style/Widget.OffGrid.ActionButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:text="‹"
            android:contentDescription="@string/back_settings" />
        <TextView
            style="@style/Widget.OffGrid.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/login_title" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/offgrid_divider" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/login_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingTop="24dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Log in to your account"
                android:textSize="16sp"
                android:textColor="@color/offgrid_text_secondary"
                android:fontFamily="sans-serif"
                android:textStyle="normal"
                android:includeFontPadding="false"
                android:layout_marginTop="8dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textSize="12sp"
                    android:textColor="@color/offgrid_text_secondary"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:includeFontPadding="false"
                    android:labelFor="@id/login_email" />
                <android.widget.EditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:id="@+id/login_email"
                    android:hint="you@example.com"
                    android:inputType="textEmailAddress"
                    android:textSize="14sp"
                    android:textColor="@color/offgrid_text"
                    android:textColorHint="@color/offgrid_text_secondary"
                    android:background="@color/offgrid_field"
                    android:backgroundTint="@color/offgrid_field"
                    android:fontFamily="sans-serif"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:imeOptions="actionNext"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:longClickable="true"
                    android:cursorVisible="true"
                    android:importantForAutofill="auto"
                    android:autofillHints="username"
                    android:saveEnabled="true"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textSize="12sp"
                    android:textColor="@color/offgrid_text_secondary"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:includeFontPadding="false"
                    android:labelFor="@id/login_password" />
                <android.widget.EditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:id="@+id/login_password"
                    android:hint="Enter password"
                    android:inputType="textPassword"
                    android:textSize="14sp"
                    android:textColor="@color/offgrid_text"
                    android:textColorHint="@color/offgrid_text_secondary"
                    android:background="@color/offgrid_field"
                    android:backgroundTint="@color/offgrid_field"
                    android:fontFamily="sans-serif"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:imeOptions="actionDone"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:longClickable="true"
                    android:cursorVisible="true"
                    android:importantForAutofill="auto"
                    android:autofillHints="password"
                    android:saveEnabled="false"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
            <android.widget.Button
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:id="@+id/login_forgot_password"
                android:text="Forgot password?"
                android:textSize="14sp"
                android:textColor="@color/offgrid_text"
                android:background="@color/offgrid_button"
                android:backgroundTint="@color/offgrid_button"
                android:fontFamily="sans-serif"
                android:textAllCaps="false"
                android:textStyle="normal"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="8dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:includeFontPadding="false"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="8dp" />
            <android.widget.Button
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:id="@+id/login_submit"
                android:text="Log in"
                android:textSize="14sp"
                android:textColor="@color/offgrid_background"
                android:background="@color/offgrid_text"
                android:backgroundTint="@color/offgrid_text"
                android:fontFamily="sans-serif"
                android:textAllCaps="false"
                android:textStyle="normal"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="8dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:includeFontPadding="false"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="12dp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="New here?"
                android:textSize="13sp"
                android:textColor="@color/offgrid_text_secondary"
                android:fontFamily="sans-serif"
                android:textStyle="normal"
                android:includeFontPadding="false"
                android:gravity="center"
                android:layout_marginTop="24dp" />
            <android.widget.Button
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:id="@+id/login_open_register"
                android:text="Create account"
                android:textSize="14sp"
                android:textColor="@color/offgrid_text"
                android:background="@color/offgrid_button"
                android:backgroundTint="@color/offgrid_button"
                android:fontFamily="sans-serif"
                android:textAllCaps="false"
                android:textStyle="normal"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="8dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:includeFontPadding="false"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
