<?xml version="1.0" encoding="utf-8"?>
<!--
    @file screen_contact_list.xml
    @brief Lista przykładowych rozmów z wejściem do ekranu czatu.
    @details MainActivity podłącza kliknięcia kontaktów i wspólną nawigację; dane rozmów są statyczne.
-->
<!--
    LISTA ROZMÓW

    Ekran korzysta ze wspólnej palety OffGrid i dolnego paska nawigacji.
    Aktywność obsługuje wszystkie cztery zakładki. Wiersze zawierają przykładowe rozmowy.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/contacts_screen"
    android:orientation="vertical"
    android:background="@color/offgrid_background"
    android:layoutDirection="ltr"
    tools:layout_width="360dp"
    tools:layout_height="720dp"
    tools:ignore="HardcodedText">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Messages"
            android:textSize="22sp"
            android:textColor="@color/offgrid_text"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:layout_weight="1" />
        <android.widget.Button
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:id="@+id/contacts_new_message"
            android:text="+"
            android:textSize="14sp"
            android:textColor="@color/offgrid_text"
            android:background="@color/offgrid_button"
            android:backgroundTint="@color/offgrid_button"
            android:fontFamily="sans-serif"
            android:textAllCaps="false"
            android:textStyle="normal"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="8dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:includeFontPadding="false"
            android:clickable="false"
            android:focusable="false"
            android:contentDescription="New message" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/offgrid_divider" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/contacts_content"
            android:orientation="vertical"
            android:padding="16dp">
            <!--
                @brief Wizualne pole wyszukiwania rozmów.
                @note Pole ma wyłączoną edycję i nie filtruje listy.
            -->
            <android.widget.EditText
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:id="@+id/contacts_search"
                android:hint="Search conversations..."
                android:inputType="textFilter"
                android:textSize="14sp"
                android:textColor="@color/offgrid_text"
                android:textColorHint="@color/offgrid_text_secondary"
                android:background="@color/offgrid_field"
                android:backgroundTint="@color/offgrid_field"
                android:fontFamily="sans-serif"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="false"
                android:longClickable="false"
                android:cursorVisible="false"
                android:importantForAutofill="no"
                android:saveEnabled="false"
                android:contentDescription="Search conversations" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Conversations"
                android:textSize="12sp"
                android:textColor="@color/offgrid_text_secondary"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />
            <!--
                @brief Wiersz Sarah Miller otwierający ChatActivity z nazwą tego kontaktu.
                @note Podgląd wiadomości, godzina i licznik nieprzeczytanych wiadomości są danymi przykładowymi.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:id="@+id/contacts_sarah"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="SM"
                    android:textSize="14sp"
                    android:textColor="@color/offgrid_text"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:background="@color/offgrid_button" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sarah Miller"
                        android:textSize="14sp"
                        android:textColor="@color/offgrid_text"
                        android:fontFamily="sans-serif"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="See you tomorrow!"
                        android:textSize="12sp"
                        android:textColor="@color/offgrid_text_secondary"
                        android:fontFamily="sans-serif"
                        android:textStyle="normal"
                        android:includeFontPadding="false"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end"
                    android:layout_marginStart="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9:24"
                        android:textSize="10sp"
                        android:textColor="@color/offgrid_text_secondary"
                        android:fontFamily="sans-serif"
                        android:textStyle="normal"
                        android:includeFontPadding="false" />
                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:text="2"
                        android:textSize="11sp"
                        android:textColor="@color/offgrid_text"
                        android:fontFamily="sans-serif"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:background="@color/offgrid_button"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/offgrid_divider" />
            <!--
                @brief Wiersz Alex Johnson otwierający ChatActivity z nazwą tego kontaktu.
                @note Ekran czatu ukrywa dla Alexa przykładowe wiadomości należące do rozmowy z Sarah.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:id="@+id/contacts_alex"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="AJ"
                    android:textSize="14sp"
                    android:textColor="@color/offgrid_text"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:background="@color/offgrid_button" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Alex Johnson"
                        android:textSize="14sp"
                        android:textColor="@color/offgrid_text"
                        android:fontFamily="sans-serif"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sounds good"
                        android:textSize="12sp"
                        android:textColor="@color/offgrid_text_secondary"
                        android:fontFamily="sans-serif"
                        android:textStyle="normal"
                        android:includeFontPadding="false"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end"
                    android:layout_marginStart="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8:17"
                        android:textSize="10sp"
                        android:textColor="@color/offgrid_text_secondary"
                        android:fontFamily="sans-serif"
                        android:textStyle="normal"
                        android:includeFontPadding="false" />
                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:text="1"
                        android:textSize="11sp"
                        android:textColor="@color/offgrid_text"
                        android:fontFamily="sans-serif"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:background="@color/offgrid_button"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/offgrid_divider" />
        </LinearLayout>
    </ScrollView>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/offgrid_divider" />
    <!--
        @brief Wspólny pasek zakładek umieszczony poza przewijaną treścią.
        @details Aktywność podłącza ten include przez bindMainTabs z zakładką MainTab.CHATS.
    -->
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="60dp" />
</LinearLayout>
