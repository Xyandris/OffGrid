<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/contacts_screen"
    android:background="@color/offgrid_background"
    android:layoutDirection="ltr"
    tools:layout_width="360dp"
    tools:layout_height="720dp"
    tools:ignore="HardcodedText"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:minHeight="96dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Messages"
            android:layout_weight="1"
            style="@style/Widget.OffGrid.ScreenTitle" />
        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:id="@+id/contacts_new_message"
            android:src="@drawable/ic_compose"
            android:contentDescription="New message"
            android:clickable="false"
            android:focusable="false"
            style="@style/Widget.OffGrid.IconButton" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">
        <android.widget.EditText
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:id="@+id/contacts_search"
            android:hint="Search..."
            android:background="@drawable/bg_field"
            android:backgroundTint="@null"
            android:textColor="@color/offgrid_text"
            android:textColorHint="@color/offgrid_text_secondary"
            android:textSize="16sp"
            android:fontFamily="sans-serif"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            android:longClickable="false"
            android:cursorVisible="false"
            android:importantForAutofill="no"
            android:saveEnabled="false"
            android:inputType="textFilter"
            android:drawableStart="@drawable/ic_search"
            android:drawableTint="@color/offgrid_text_secondary"
            android:drawablePadding="10dp"
            android:contentDescription="Search conversations" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/offgrid_divider"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/contacts_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minHeight="76dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical"
                android:id="@+id/contacts_sarah"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="SM"
                    style="@style/Widget.OffGrid.Avatar" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sarah Miller"
                        style="@style/Widget.OffGrid.ContactName" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Do jutra!"
                        android:layout_marginTop="4dp"
                        style="@style/Widget.OffGrid.ContactPreview" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10:29"
                        style="@style/Widget.OffGrid.ContactTime" />
                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:text="2"
                        android:textSize="11sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:background="@drawable/bg_badge"
                        android:layout_marginTop="7dp" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/offgrid_divider"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minHeight="76dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical"
                android:id="@+id/contacts_alex"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="AJ"
                    style="@style/Widget.OffGrid.Avatar" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Alex Johnson"
                        style="@style/Widget.OffGrid.ContactName" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dobra 👍"
                        android:layout_marginTop="4dp"
                        style="@style/Widget.OffGrid.ContactPreview" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9:17"
                        style="@style/Widget.OffGrid.ContactTime" />
                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:text="1"
                        android:textSize="11sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:background="@drawable/bg_badge"
                        android:layout_marginTop="7dp" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/offgrid_divider"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minHeight="76dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical"
                android:id="@+id/contacts_kasia"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="false"
                android:focusable="false">
                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="K"
                    style="@style/Widget.OffGrid.Avatar" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kasia"
                        style="@style/Widget.OffGrid.ContactName" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Shared location"
                        android:layout_marginTop="4dp"
                        style="@style/Widget.OffGrid.ContactPreview" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yesterday"
                        style="@style/Widget.OffGrid.ContactTime" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/offgrid_divider"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minHeight="76dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical"
                android:id="@+id/contacts_jacek"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="false"
                android:focusable="false">
                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="J"
                    style="@style/Widget.OffGrid.Avatar" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Jacek"
                        style="@style/Widget.OffGrid.ContactName" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Halo"
                        android:layout_marginTop="4dp"
                        style="@style/Widget.OffGrid.ContactPreview" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mon"
                        style="@style/Widget.OffGrid.ContactTime" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/offgrid_divider"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minHeight="76dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical"
                android:id="@+id/contacts_maria"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="false"
                android:focusable="false">
                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="M"
                    style="@style/Widget.OffGrid.Avatar" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Maria"
                        style="@style/Widget.OffGrid.ContactName" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="😎"
                        android:layout_marginTop="4dp"
                        style="@style/Widget.OffGrid.ContactPreview" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sun"
                        style="@style/Widget.OffGrid.ContactTime" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/offgrid_divider"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </ScrollView>
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="78dp" />
</LinearLayout>
