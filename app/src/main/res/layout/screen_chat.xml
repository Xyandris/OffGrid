<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/chat_screen"
    android:background="@color/offgrid_background"
    android:layoutDirection="ltr"
    tools:layout_width="360dp"
    tools:layout_height="720dp"
    tools:ignore="HardcodedText"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:minHeight="96dp"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">
        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:id="@+id/chat_back"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            style="@style/Widget.OffGrid.IconButton" />
        <TextView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:text="SM"
            android:id="@+id/chat_avatar"
            android:layout_marginStart="4dp"
            style="@style/Widget.OffGrid.Avatar" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginStart="12dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sarah Miller"
                android:id="@+id/chat_contact_name"
                android:textSize="25sp"
                style="@style/Widget.OffGrid.ContactName" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Online"
                android:layout_marginTop="3dp"
                style="@style/Widget.OffGrid.ScreenDescription" />
        </LinearLayout>
        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:id="@+id/chat_more"
            android:src="@drawable/ic_more"
            android:contentDescription="More options"
            android:clickable="false"
            android:focusable="false"
            style="@style/Widget.OffGrid.IconButton" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/offgrid_divider"
        android:importantForAccessibility="no"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/chat_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_bubble_incoming"
                android:padding="12dp"
                android:layout_gravity="start"
                android:id="@+id/chat_message_1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hi! Are you going to the gala tomorrow?"
                    style="@style/Widget.OffGrid.MessageText" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:19"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.OffGrid.MessageTime" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_bubble_outgoing"
                android:padding="12dp"
                android:layout_gravity="end"
                android:id="@+id/chat_message_2"
                android:layout_marginTop="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yes 👍"
                    style="@style/Widget.OffGrid.MessageText"
                    android:textColor="@color/offgrid_message_outgoing_text" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10:22"
                        android:layout_marginTop="8dp"
                        style="@style/Widget.OffGrid.MessageTime"
                        android:textColor="@color/offgrid_message_outgoing_secondary" />
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_double_check"
                        android:tint="@color/offgrid_message_outgoing_secondary"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/chat_message_3"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_bubble_incoming"
                    android:padding="12dp"
                    android:layout_gravity="start">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Great!"
                        style="@style/Widget.OffGrid.MessageText" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10:28"
                        android:layout_marginTop="8dp"
                        style="@style/Widget.OffGrid.MessageTime" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_bubble_incoming"
                    android:padding="12dp"
                    android:layout_gravity="start"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="See you tomorrow!"
                        style="@style/Widget.OffGrid.MessageText" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10:29"
                        android:layout_marginTop="8dp"
                        style="@style/Widget.OffGrid.MessageTime" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/offgrid_divider"
        android:importantForAccessibility="no"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">
        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:id="@+id/chat_attach"
            android:src="@drawable/ic_add"
            android:contentDescription="Add attachment"
            android:clickable="false"
            android:focusable="false"
            style="@style/Widget.OffGrid.IconButton" />
        <android.widget.EditText
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:id="@+id/chat_message_input"
            android:hint="Type a message..."
            android:background="@drawable/bg_field"
            android:backgroundTint="@null"
            android:textColor="@color/offgrid_text"
            android:textColorHint="@color/offgrid_text_secondary"
            android:textSize="16sp"
            android:fontFamily="sans-serif"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            android:longClickable="false"
            android:cursorVisible="false"
            android:importantForAutofill="no"
            android:saveEnabled="false"
            android:inputType="textCapSentences|textMultiLine"
            android:drawableEnd="@drawable/ic_emoji"
            android:drawableTint="@color/offgrid_text_secondary"
            android:drawablePadding="8dp"
            android:contentDescription="Message input"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="8dp" />
        <ImageButton
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:id="@+id/chat_send"
            android:src="@drawable/ic_send"
            android:contentDescription="Send message"
            android:clickable="false"
            android:focusable="false"
            android:background="@drawable/bg_send"
            android:tint="@color/offgrid_message_outgoing_text"
            style="@style/Widget.OffGrid.IconButton" />
    </LinearLayout>
</LinearLayout>
