<?xml version="1.0" encoding="utf-8"?>
<!--
INDIVIDUAL CHAT / STATIC LAYOUT MOCKUP

Place screen_chat.xml in app/src/main/res/layout/ and open Design or Split.
This screen is self-contained: all text, colors and placeholder rows are inline.
No other XML, drawable, string, style, image or Java/Kotlin file is required.
Controls are deliberately inert; the file presents placement and spacing only.
Uses Android framework Views compatible with Android 9 (API 28) and newer.
Set minSdk = 28 in your app module to make Android 9 the minimum version.
The tools dimensions are only a preview size; the layout fills its container.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/chat_screen"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layoutDirection="ltr"
    tools:layout_width="360dp"
    tools:layout_height="720dp"
    tools:ignore="HardcodedText">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <android.widget.Button
            android:layout_width="36dp"
            android:layout_height="44dp"
            android:id="@+id/chat_back"
            android:text="‹"
            android:textSize="14sp"
            android:textColor="#282828"
            android:background="#E1E1E1"
            android:backgroundTint="#E1E1E1"
            android:fontFamily="sans-serif"
            android:textAllCaps="false"
            android:textStyle="normal"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="8dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:includeFontPadding="false"
            android:clickable="false"
            android:focusable="false"
            android:contentDescription="Back" />
        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="SM"
            android:textSize="14sp"
            android:textColor="#282828"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:gravity="center"
            android:background="#E1E1E1"
            android:layout_marginStart="8dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginStart="10dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sarah Miller"
                android:textSize="15sp"
                android:textColor="#282828"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Online"
                android:textSize="11sp"
                android:textColor="#686868"
                android:fontFamily="sans-serif"
                android:textStyle="normal"
                android:includeFontPadding="false"
                android:layout_marginTop="4dp" />
        </LinearLayout>
        <android.widget.Button
            android:layout_width="36dp"
            android:layout_height="44dp"
            android:id="@+id/chat_more"
            android:text="⋮"
            android:textSize="14sp"
            android:textColor="#282828"
            android:background="#E1E1E1"
            android:backgroundTint="#E1E1E1"
            android:fontFamily="sans-serif"
            android:textAllCaps="false"
            android:textStyle="normal"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="8dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:includeFontPadding="false"
            android:clickable="false"
            android:focusable="false"
            android:contentDescription="More options" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D0D0D0" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/chat_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textSize="11sp"
                android:textColor="#686868"
                android:fontFamily="sans-serif"
                android:textStyle="normal"
                android:includeFontPadding="false"
                android:gravity="center"
                android:layout_marginBottom="24dp" />
            <LinearLayout
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:id="@+id/chat_message_1"
                android:orientation="vertical"
                android:background="#F0F0F0"
                android:padding="12dp"
                android:layout_gravity="start"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Are we still meeting tonight?"
                    android:textSize="14sp"
                    android:textColor="#282828"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:includeFontPadding="false" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="9:12"
                    android:textSize="10sp"
                    android:textColor="#686868"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:includeFontPadding="false"
                    android:gravity="end"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:id="@+id/chat_message_2"
                android:orientation="vertical"
                android:background="#E1E1E1"
                android:padding="12dp"
                android:layout_gravity="end"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Yes! See you at 7."
                    android:textSize="14sp"
                    android:textColor="#282828"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:includeFontPadding="false" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="9:18"
                    android:textSize="10sp"
                    android:textColor="#686868"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:includeFontPadding="false"
                    android:gravity="end"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:id="@+id/chat_message_3"
                android:orientation="vertical"
                android:background="#F0F0F0"
                android:padding="12dp"
                android:layout_gravity="start"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Great, see you there."
                    android:textSize="14sp"
                    android:textColor="#282828"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:includeFontPadding="false" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="9:20"
                    android:textSize="10sp"
                    android:textColor="#686868"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:includeFontPadding="false"
                    android:gravity="end"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D0D0D0" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">
        <android.widget.Button
            android:layout_width="36dp"
            android:layout_height="44dp"
            android:id="@+id/chat_attach"
            android:text="+"
            android:textSize="14sp"
            android:textColor="#282828"
            android:background="#E1E1E1"
            android:backgroundTint="#E1E1E1"
            android:fontFamily="sans-serif"
            android:textAllCaps="false"
            android:textStyle="normal"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="8dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:includeFontPadding="false"
            android:clickable="false"
            android:focusable="false"
            android:contentDescription="Add attachment" />
        <android.widget.EditText
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:id="@+id/chat_message_input"
            android:hint="Type a message..."
            android:inputType="textShortMessage"
            android:textSize="14sp"
            android:textColor="#282828"
            android:textColorHint="#686868"
            android:background="#F0F0F0"
            android:backgroundTint="#F0F0F0"
            android:fontFamily="sans-serif"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            android:longClickable="false"
            android:cursorVisible="false"
            android:importantForAutofill="no"
            android:saveEnabled="false"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Message" />
        <android.widget.Button
            android:layout_width="56dp"
            android:layout_height="44dp"
            android:id="@+id/chat_send"
            android:text="Send"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="#282828"
            android:backgroundTint="#282828"
            android:fontFamily="sans-serif"
            android:textAllCaps="false"
            android:textStyle="normal"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="8dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:includeFontPadding="false"
            android:clickable="false"
            android:focusable="false" />
    </LinearLayout>
</LinearLayout>
