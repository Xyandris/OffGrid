<?xml version="1.0" encoding="utf-8"?>
<!--
    @file activity_main.xml
    @brief Layout główny aktywności MainActivity.
    @details Dołącza screen_contact_list.xml przez include o identyfikatorze chatList.
    Główny FrameLayout otrzymuje odstępy pasków systemowych i klawiatury przez showOffGridScreen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/offgrid_background"
    tools:context=".MainActivity">

    <include
        android:id="@+id/chatList"
        layout="@layout/screen_contact_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
