<?xml version="1.0" encoding="utf-8"?>
<!--
    @file res/drawable/bg_logout.xml
    @brief Tło przycisku wylogowania w ustawieniach.
    @details Wypełnienie i obrys korzystają z dedykowanych kolorów wylogowania. Dotknięcie widoku daje  wizualną reakcję w kolorze `offgrid_ripple`.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/offgrid_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/offgrid_logout_background" />
            <stroke android:width="1dp" android:color="@color/offgrid_logout_outline" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</ripple>