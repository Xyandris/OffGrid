<?xml version="1.0" encoding="utf-8"?>
<!--
    @file res/drawable/bg_avatar.xml
    @brief Obrysowane tło awatara z inicjałami.
    @details Owal łączy kolor tła ekranu z obrysem `offgrid_avatar_outline`. Korzystają z niego styl
      `Widget.OffGrid.Avatar` oraz awatary w wyszukiwaniu i zaproszeniach.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@color/offgrid_background" />
    <stroke android:width="1dp" android:color="@color/offgrid_avatar_outline" />
</shape>