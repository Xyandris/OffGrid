<?xml version="1.0" encoding="utf-8"?>
<!--
    @file res/mipmap-anydpi/ic_launcher.xml
    @brief Adaptacyjna ikona uruchamiania OffGrid.
    @details Łączy jednolite tło `ic_launcher_background` z warstwą logo `ic_launcher_foreground`.
             Launcher używa obu warstw przy nakładaniu swojej maski.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>