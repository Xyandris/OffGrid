<!--
    @file res/values/themes.xml
    @brief Motyw aplikacji OffGrid oparty na Material 3.
    @details `Base.Theme.OffGrid` dziedziczy po `Theme.Material3.DayNight.NoActionBar` i wiąże tło okna,
     powierzchnie oraz tekst z paletą `offgrid_*`. `Theme.OffGrid` udostępnia tę konfigurację jako motyw aplikacji.
-->
<resources>
    <style name="Base.Theme.OffGrid" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/offgrid_background</item>
        <item name="colorSurface">@color/offgrid_background</item>
        <item name="colorOnSurface">@color/offgrid_text</item>
        <item name="colorOnSurfaceVariant">@color/offgrid_text_secondary</item>
        <item name="colorPrimary">@color/offgrid_text</item>
        <item name="colorOnPrimary">@color/offgrid_background</item>
        <item name="android:colorAccent">@color/offgrid_text</item>
    </style>
    <style name="Theme.OffGrid" parent="Base.Theme.OffGrid" />
</resources>