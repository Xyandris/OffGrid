<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.OffGrid.ActionButton" parent="@android:style/Widget.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@color/offgrid_button</item>
        <item name="android:backgroundTint">@color/offgrid_button</item>
        <item name="android:textColor">@color/offgrid_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.OffGrid.OutlinedButton" parent="Widget.OffGrid.ActionButton">
        <item name="android:background">@color/offgrid_field</item>
        <item name="android:backgroundTint">@color/offgrid_field</item>
    </style>

    <style name="Widget.OffGrid.TabButton" parent="Widget.OffGrid.ActionButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_navigation_tab</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textSize">11sp</item>
        <item name="android:padding">2dp</item>
    </style>

    <style name="Widget.OffGrid.ScreenTitle" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/offgrid_text</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="Widget.OffGrid.SectionTitle" parent="Widget.OffGrid.ScreenTitle">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/offgrid_text_secondary</item>
    </style>

    <style name="Widget.OffGrid.ScreenDescription" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/offgrid_text_secondary</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
