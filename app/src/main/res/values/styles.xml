<?xml version="1.0" encoding="utf-8"?>
<!--
    @file res/values/styles.xml
    @brief Wspólne style widoków OffGrid.
    @details Definiuje wygląd przycisków, kart nawigacji, nagłówków, awatarów i treści rozmów. Style
     odwołują się do nazwanych kolorów, dzięki czemu korzystają z palety wybranej przez konfigurację jasną lub ciemną.
-->
<resources>
    <style name="Widget.OffGrid.ActionButton" parent="@android:style/Widget.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@color/offgrid_button</item>
        <item name="android:backgroundTint">@color/offgrid_button</item>
        <item name="android:textColor">@color/offgrid_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.OffGrid.OutlinedButton" parent="Widget.OffGrid.ActionButton">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <!--
        Waga przy szerokości 0 dp daje kartom równy udział w szerokości paska. Selektor
        `navigation_icon` barwi tekst i ikonę.
    -->
    <style name="Widget.OffGrid.TabButton" parent="Widget.OffGrid.ActionButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">76dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_navigation_tab</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/navigation_icon</item>
        <item name="android:drawableTint">@color/navigation_icon</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="Widget.OffGrid.IconButton" parent="@android:style/Widget.ImageButton">
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:tint">@color/offgrid_text</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Bazowy styl tytułu oznacza widok jako nagłówek dostępności. `SectionTitle` dziedziczy ten atrybut. -->
    <style name="Widget.OffGrid.ScreenTitle" parent="">
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">@color/offgrid_text</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="Widget.OffGrid.SectionTitle" parent="Widget.OffGrid.ScreenTitle">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/offgrid_text_secondary</item>
    </style>

    <style name="Widget.OffGrid.ScreenDescription" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/offgrid_text_secondary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.OffGrid.Avatar" parent="">
        <item name="android:background">@drawable/bg_avatar</item>
        <item name="android:textColor">@color/offgrid_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.OffGrid.ContactName" parent="">
        <item name="android:textColor">@color/offgrid_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Podgląd ostatniej wiadomości zajmuje jeden wiersz. Dłuższy tekst jest skracany na końcu. -->
    <style name="Widget.OffGrid.ContactPreview" parent="Widget.OffGrid.ScreenDescription">
        <item name="android:textSize">15sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Widget.OffGrid.ContactTime" parent="Widget.OffGrid.ScreenDescription">
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">end</item>
    </style>

    <!-- Maksymalna szerokość tekstu wiadomości ogranicza szerokość jego bloku w bąbelku. -->
    <style name="Widget.OffGrid.MessageText" parent="">
        <item name="android:textColor">@color/offgrid_text</item>
        <item name="android:textSize">21sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxWidth">232dp</item>
    </style>

    <style name="Widget.OffGrid.MessageTime" parent="Widget.OffGrid.ScreenDescription">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.OffGrid.SettingsLabel" parent="Widget.OffGrid.ContactName">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Widget.OffGrid.SettingsDescription" parent="Widget.OffGrid.ScreenDescription">
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

</resources>