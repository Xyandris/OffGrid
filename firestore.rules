/// @file firestore.rules
/// @brief Reguły dostępu do publicznych profili katalogu użytkowników.
/// @details Dopuszcza odczyt dla zalogowanych i zapis własnego dokumentu zgodnego ze schematem profilu.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    /// @brief Obejmuje dokumenty profili, których identyfikator odpowiada UID konta.
    /// @details Reguły dotyczą dokumentów tej kolekcji; nie otwierają dostępu do innych ścieżek.
    match /users/{uid} {
      /// @brief Sprawdza, czy zalogowana osoba jest właścicielem dokumentu.
      /// @return Wartość true, gdy UID sesji zgadza się z uid przechwyconym ze ścieżki dokumentu.
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      /// @brief Weryfikuje dozwolone pola, typy i długości nowej wersji profilu.
      /// @return Wartość true dla wymaganych nazw i opcjonalnego poprawnego photoUrl.
      /// @details Nazwy mają długości 1–100 i 1–200, a adres zdjęcia jest null lub tekstem do 2048 znaków.
      ///          Walidacja jest wykonywana dla tworzenia i aktualizacji dokumentu.
      function validProfile() {
        let data = request.resource.data;
        let photo = data.get('photoUrl', null);

        return data.keys().hasAll(['displayName', 'displayNameSearch'])
          && data.keys().hasOnly(['displayName', 'displayNameSearch', 'photoUrl'])
          && data.displayName is string
          && data.displayName.size() >= 1
          && data.displayName.size() <= 100
          && data.displayNameSearch is string
          && data.displayNameSearch.size() >= 1
          && data.displayNameSearch.size() <= 200
          && (photo == null || (photo is string && photo.size() <= 2048));
      }

      /// @brief Pozwala zalogowanym użytkownikom odczytywać i wyszukiwać publiczne profile.
      allow read: if request.auth != null;
      /// @brief Pozwala właścicielowi tworzyć i aktualizować wyłącznie poprawny profil.
      allow create, update: if isOwner() && validProfile();
      /// @brief Pozwala właścicielowi usunąć własny dokument profilu.
      allow delete: if isOwner();
    }
  }
}
